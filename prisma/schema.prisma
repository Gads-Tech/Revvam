generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                @id @default(cuid())
  name                    String
  username                String                @unique
  email                   String                @unique
  passwordHash            String?
  role                    UserRole              @default(USER)
  image                   String?
  bio                     String?
  location                String?
  emailVerified           DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  onboardingType          OnboardingType?
  driverProfile           DriverProfile?
  mentionsMade            ModificationMention[] @relation("MentionedBy")
  mentionsReceived        ModificationMention[] @relation("MentionedUser")
  sessions                Session[]
  vehicles                Vehicle[]
  posts                   Post[]
  following               Follow[]              @relation("Following")
  followers               Follow[]              @relation("Followers")
  notificationsReceived   Notification[]        @relation("NotificationRecipient")
  notificationsSent       Notification[]        @relation("NotificationActor")
  conversationMemberships ConversationMember[]
  messagesSent            Message[]
  chatRequestsSent        ChatRequest[]          @relation("ChatRequestSender")
  chatRequestsReceived    ChatRequest[]          @relation("ChatRequestRecipient")
}

model DriverProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  ownsCar   Boolean  @default(false)
  interests String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id            String                @id @default(cuid())
  userId        String
  make          String
  model         String
  year          Int?
  image         String?
  isFeatured    Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  type          String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  modifications VehicleModification[]
  photos        VehiclePhoto[]

  @@index([userId])
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleModification {
  id          String                @id @default(cuid())
  vehicleId   String
  category    ModificationCategory
  title       String
  description String?
  cost        Decimal?              @db.Decimal(12, 2)
  installedAt DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  mentions    ModificationMention[]
  photos      ModificationPhoto[]
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, category])
  @@index([installedAt])
}

model ModificationPhoto {
  id             String              @id @default(cuid())
  modificationId String
  url            String
  createdAt      DateTime            @default(now())
  modification   VehicleModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@index([modificationId])
}

model ModificationMention {
  id              String              @id @default(cuid())
  modificationId  String
  mentionedUserId String
  mentionedById   String
  createdAt       DateTime             @default(now())
  mentionedBy     User                @relation("MentionedBy", fields: [mentionedById], references: [id], onDelete: Cascade)
  mentionedUser   User                @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  modification    VehicleModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@unique([modificationId, mentionedUserId])
  @@index([mentionedUserId])
  @@index([mentionedById])
  @@index([modificationId])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  actorId       String
  type          NotificationType
  title         String
  body          String
  href          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  chatRequestId String?          @unique
  user          User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor         User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  chatRequest   ChatRequest?     @relation(fields: [chatRequestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ChatRequest {
  id           String            @id @default(cuid())
  senderId     String
  recipientId  String
  status       ChatRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sender       User              @relation("ChatRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User              @relation("ChatRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@index([senderId, status])
}

model Conversation {
  id        String              @id @default(cuid())
  directKey String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum NotificationType {
  FOLLOW
  MESSAGE
  CHAT_REQUEST
  CHAT_ACCEPTED
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ModificationCategory {
  PERFORMANCE
  EXTERIOR
  INTERIOR
  WHEELS_TIRES
  SUSPENSION
  EXHAUST
  AUDIO
  LIGHTING
  ENGINE
  MAINTENANCE
  OTHER
}

enum UserRole {
  USER
  MECHANIC
  DEALERSHIP
  ADMIN
  MECHANIC_SHOP
}

enum OnboardingType {
  DRIVER
  MECHANIC
  MECHANIC_SHOP
  DEALERSHIP
  EXPLORER
}
