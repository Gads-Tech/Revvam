generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                  @id @default(cuid())
  name                    String
  username                String                  @unique
  email                   String                  @unique
  passwordHash            String?
  role                    UserRole                @default(USER)
  image                   String?
  bio                     String?
  location                String?
  readReceiptsEnabled     Boolean                 @default(true)
  emailVerified           DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  onboardingType          OnboardingType?
  driverProfile           DriverProfile?
  mentionsMade            ModificationMention[]   @relation("MentionedBy")
  mentionsReceived        ModificationMention[]   @relation("MentionedUser")
  postMentionsMade        PostMention[]           @relation("PostMentionedBy")
  postMentionsReceived    PostMention[]           @relation("PostMentionedUser")
  postLikes               PostLike[]
  postComments            PostComment[]
  postShares              PostShare[]
  sessions                Session[]
  vehicles                Vehicle[]
  emergencyRequests       EmergencyRequest[]
  emergencyOffers         EmergencyOffer[] @relation("EmergencyOfferMechanic")
  posts                   Post[]
  following               Follow[]                @relation("Following")
  followers               Follow[]                @relation("Followers")
  notificationsReceived   Notification[]          @relation("NotificationRecipient")
  notificationsSent       Notification[]          @relation("NotificationActor")
  conversationMemberships ConversationMember[]
  messagesSent            Message[]               @relation("MessagesSent")
  chatRequestsSent        ChatRequest[]           @relation("ChatRequestSender")
  chatRequestsReceived    ChatRequest[]           @relation("ChatRequestRecipient")
  readReceiptPreferences  ReadReceiptPreference[] @relation("ReadReceiptOwner")
  readReceiptOverrides    ReadReceiptPreference[] @relation("ReadReceiptTarget")
  messageDeletions        MessageDeletion[]       @relation("MessageDeletionUser")
}

model DriverProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  ownsCar   Boolean  @default(false)
  interests String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id            String                @id @default(cuid())
  userId        String
  make          String
  model         String
  year          Int?
  image         String?
  isFeatured    Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  type          String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  modifications VehicleModification[]
  photos        VehiclePhoto[]
  emergencyRequests EmergencyRequest[]

  @@index([userId])
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleModification {
  id          String                @id @default(cuid())
  vehicleId   String
  category    ModificationCategory
  title       String
  description String?
  cost        Decimal?              @db.Decimal(12, 2)
  installedAt DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  mentions    ModificationMention[]
  photos      ModificationPhoto[]
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, category])
  @@index([installedAt])
}

model ModificationPhoto {
  id             String              @id @default(cuid())
  modificationId String
  url            String
  createdAt      DateTime            @default(now())
  modification   VehicleModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@index([modificationId])
}

model ModificationMention {
  id              String              @id @default(cuid())
  modificationId  String
  mentionedUserId String
  mentionedById   String
  createdAt       DateTime             @default(now())
  mentionedBy     User                 @relation("MentionedBy", fields: [mentionedById], references: [id], onDelete: Cascade)
  mentionedUser   User                 @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  modification    VehicleModification  @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@unique([modificationId, mentionedUserId])
  @@index([mentionedUserId])
  @@index([mentionedById])
  @@index([modificationId])
}

model Post {
  id        String         @id @default(cuid())
  authorId  String
  content   String
  image     String?
  video     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  PostComment[]
  shares    PostShare[]
  mentions  PostMention[]

  @@index([authorId, createdAt])
}

model EmergencyRequest {
  id                  String                @id @default(cuid())
  driverId            String
  vehicleId           String?
  type                EmergencyType
  status              EmergencyStatus       @default(OPEN)
  description         String
  photo               String?
  latitude            Float
  longitude           Float
  locationLabel       String?
  acceptedOfferId     String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  acceptedAt          DateTime?
  completedAt         DateTime?
  driver              User                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle             Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  offers              EmergencyOffer[]
  acceptedOffer       EmergencyOffer?       @relation("AcceptedEmergencyOffer", fields: [acceptedOfferId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([latitude, longitude])
  @@index([driverId, createdAt])
}

model EmergencyOffer {
  id             String             @id @default(cuid())
  emergencyId    String
  mechanicId     String
  message        String?
  status         EmergencyOfferStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  emergency      EmergencyRequest   @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  mechanic       User               @relation("EmergencyOfferMechanic", fields: [mechanicId], references: [id], onDelete: Cascade)
  acceptedFor    EmergencyRequest?  @relation("AcceptedEmergencyOffer")

  @@unique([emergencyId, mechanicId])
  @@index([mechanicId, status])
  @@index([emergencyId, status])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id        String         @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  post      Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[]  @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, createdAt])
}

model PostShare {
  id        String          @id @default(cuid())
  postId    String
  userId    String
  channel   PostShareChannel @default(REVVAM)
  createdAt DateTime        @default(now())
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model PostMention {
  id              String   @id @default(cuid())
  postId          String
  mentionedUserId String
  mentionedById   String
  createdAt       DateTime @default(now())
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser   User     @relation("PostMentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionedBy     User     @relation("PostMentionedBy", fields: [mentionedById], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId])
  @@index([mentionedUserId])
  @@index([mentionedById])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  actorId       String
  type          NotificationType
  title         String
  body          String
  href          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  chatRequestId String?          @unique
  user          User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor         User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  chatRequest   ChatRequest?     @relation(fields: [chatRequestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ChatRequest {
  id           String            @id @default(cuid())
  senderId     String
  recipientId  String
  message      String?
  status       ChatRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sender       User              @relation("ChatRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User              @relation("ChatRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@index([senderId, status])
}

model Conversation {
  id        String               @id @default(cuid())
  directKey String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  replyToId      String?
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReplies")
  deletions      MessageDeletion[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("MessageDeletionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, deletedAt])
}

model ReadReceiptPreference {
  id        String   @id @default(cuid())
  ownerId   String
  targetId  String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("ReadReceiptOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target    User     @relation("ReadReceiptTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetId])
  @@index([targetId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum EmergencyType {
  BREAKDOWN
  OVERHEATING
  FLAT_TYRE
  DEAD_BATTERY
  ENGINE_PROBLEM
  ACCIDENT
  FUEL_PROBLEM
  OTHER
}

enum EmergencyStatus {
  OPEN
  OFFERS_RECEIVED
  ACCEPTED
  MECHANIC_EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}

enum EmergencyOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PostShareChannel {
  REVVAM
  EXTERNAL
}

enum UserRole {
  USER
  ADMIN
  MECHANIC
  MECHANIC_SHOP
  DEALERSHIP
}

enum OnboardingType {
  DRIVER
  EXPLORER
  MECHANIC
  MECHANIC_SHOP
  DEALERSHIP
}

enum ModificationCategory {
  PERFORMANCE
  EXTERIOR
  INTERIOR
  WHEELS_TIRES
  SUSPENSION
  EXHAUST
  AUDIO
  LIGHTING
  ENGINE
  MAINTENANCE
  OTHER
}

enum NotificationType {
  FOLLOW
  MESSAGE
  CHAT_REQUEST
  CHAT_ACCEPTED
  POST_LIKE
  POST_COMMENT
  POST_SHARE
  POST_MENTION
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}