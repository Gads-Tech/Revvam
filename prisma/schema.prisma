generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                @id @default(cuid())
  name             String
  username         String                @unique
  email            String                @unique
  passwordHash     String?
  role             UserRole              @default(USER)
  image            String?
  bio              String?
  emailVerified    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  onboardingType   OnboardingType?
  driverProfile    DriverProfile?
  mentionsMade     ModificationMention[] @relation("MentionedBy")
  mentionsReceived ModificationMention[] @relation("MentionedUser")
  sessions         Session[]
  vehicles         Vehicle[]
}

model DriverProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  ownsCar   Boolean  @default(false)
  interests String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id            String                @id @default(cuid())
  userId        String
  make          String
  model         String
  year          Int?
  image         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  type          String?
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  modifications VehicleModification[]
  photos        VehiclePhoto[]

  @@index([userId])
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleModification {
  id          String                @id @default(cuid())
  vehicleId   String
  category    ModificationCategory
  title       String
  description String?
  cost        Decimal?              @db.Decimal(12, 2)
  installedAt DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  mentions    ModificationMention[]
  photos      ModificationPhoto[]
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([vehicleId, category])
  @@index([installedAt])
}

model ModificationPhoto {
  id             String              @id @default(cuid())
  modificationId String
  url            String
  createdAt      DateTime            @default(now())
  modification   VehicleModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@index([modificationId])
}

model ModificationMention {
  id              String              @id @default(cuid())
  modificationId  String
  mentionedUserId String
  mentionedById   String
  createdAt       DateTime            @default(now())
  mentionedBy     User                @relation("MentionedBy", fields: [mentionedById], references: [id], onDelete: Cascade)
  mentionedUser   User                @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  modification    VehicleModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@unique([modificationId, mentionedUserId])
  @@index([mentionedUserId])
  @@index([mentionedById])
  @@index([modificationId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ModificationCategory {
  PERFORMANCE
  EXTERIOR
  INTERIOR
  WHEELS_TIRES
  SUSPENSION
  EXHAUST
  AUDIO
  LIGHTING
  ENGINE
  MAINTENANCE
  OTHER
}

enum UserRole {
  USER
  MECHANIC
  DEALERSHIP
  ADMIN
  MECHANIC_SHOP
}

enum OnboardingType {
  DRIVER
  MECHANIC
  MECHANIC_SHOP
  DEALERSHIP
  EXPLORER
}
